# Copy this file to .env, then edit the two REQUIRED lines below.
#
# Key names are accepted in either case (OPENAI_API_KEY or
# openai_api_key), because real secrets files disagree about this and a
# silent case mismatch is a miserable thing to debug.

# ── REQUIRED — edit these two ────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=

# ── Everything below is OPTIONAL. Leave it as-is unless you want it. ────

# Alternative LLM providers — set LLM_PROVIDER above to one of these
# instead, only if you want to try it. None is needed to run the app.
ANTHROPIC_API_KEY=
# Groq: free tier, no credit card — https://console.groq.com/keys
GROQ_API_KEY=

# No key at all? LLM_PROVIDER=mock runs the app with zero setup and zero
# network — scripted responses, not a real model. Good for `pytest` and
# for seeing the UI and the tool-calling flow without spending anything.

OPENAI_LLM_MODEL=gpt-4o-mini
ANTHROPIC_LLM_MODEL=claude-haiku-4-5-20251001
GROQ_LLM_MODEL=llama-3.3-70b-versatile

HOST=127.0.0.1
PORT=8000

# NOTE: rebuilding data/ from source (python data/refresh_data.py) needs
# no credentials at all — every data source used is keyless and public.
# See data/README.md for the provenance table and what is deliberately
# NOT fetched.

# ── Voice — optional ─────────────────────────────────────────────────────
# Skip this whole section and you still get browser-native voice (the Web
# Speech API — dictation + read-aloud, zero cost, zero setup).
#
# With OPENAI_API_KEY above set, conversation mode also works: an open
# microphone, real speech models, spoken replies, and barge-in. Both
# speech providers default to OpenAI on purpose — the app already needs
# that key for the agent, so voice adds no second credential to set up.
#
# Voice is ENGLISH ONLY. Hebrew is fully supported as typed text (place
# names, queries), but no Hebrew speech model is wired up — see
# DESIGN.md for why that scope line was drawn where it is.
STT_PROVIDER=openai
TTS_PROVIDER=openai

OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_FALLBACK_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# alloy | echo | fable | onyx | nova | shimmer
OPENAI_TTS_VOICE=alloy

# Google Cloud Text-to-Speech — only needed if you set TTS_PROVIDER=google
# instead of the OpenAI default above. A second real TTS implementation
# behind the same interface, which is what proves the provider
# abstraction is real rather than a one-off. Skip unless you want it.
GCP_TTS_API_KEY=
GOOGLE_TTS_VOICE=en-US-Neural2-C
GOOGLE_TTS_LANGUAGE_CODE=en-US
